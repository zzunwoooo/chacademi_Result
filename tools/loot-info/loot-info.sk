# /전리품 <이름> — 어떤 몹이 떨구는지 · 그 몹이 어디서 나오는지 (자동 생성 2026-10-30)
# 만드는 법: 야생 MythicMobs 드롭 + ChAcademiaWildlife habitats.yml + ItemsAdder chacademi_loot.yml. 설정이 바뀌면 다시 생성하고 /sk reload loot-info

on load:
    delete {-lootinfo::*}
    delete {-lootkey::*}
    delete {-lootname::*}
    set {-lootkey::loot_doxy_wing} to "독시날개"
    set {-lootname::loot_doxy_wing} to "독시 날개"
    add "&6── 독시 날개 &7(일반) &6──" to {-lootinfo::loot_doxy_wing::*}
    add "&f· &e독시 &7(이로치 포함) &7· 1~2개" to {-lootinfo::loot_doxy_wing::*}
